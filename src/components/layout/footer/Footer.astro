---
import Container from "@components/ui/Container.astro";
import SocialLinks from "@components/common/SocialLinks.astro";
import Logo from "@components/common/Logo.astro";
import { siteConfig } from "@data/siteConfig";

const currentYear = new Date().getFullYear();
---

<footer class="bg-[var(--bg-footer)] text-white border-t border-white/10">
  <Container>
    <div class="py-16 grid gap-12 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
      <!-- Brand + Newsletter -->
      <div class="sm:col-span-2 lg:col-span-1">
        <Logo variant="dark" />

        <p class="font-body text-sm text-white/50 mb-6 leading-relaxed">
          {siteConfig.footer.brief}
        </p>

        <div class="mb-6">
          <h4
            class="font-heading font-semibold text-xs text-white/70 tracking-wider mb-3"
          >
            Suscribite a nuestro catálogo
          </h4>
          <form onsubmit="event.preventDefault()" class="flex">
            <input
              type="email"
              placeholder="Tu email corporativo"
              aria-label="Email para suscripción"
              class="flex-1 h-10 px-4 bg-white/10 border border-white/20 text-white text-sm font-body placeholder:text-white/40 focus:outline-none focus:border-white/50 rounded-l-[var(--radius-md)]"
            />
            <button
              type="submit"
              class="h-10 px-4 bg-white text-[var(--bg-footer)] border border-white font-semibold hover:bg-white/90 transition-colors rounded-r-[var(--radius-md)]"
            >
              →
            </button>
          </form>
        </div>

        <SocialLinks size="sm" class="flex gap-2" />
      </div>

      <!-- Productos -->
      <div>
        <h4
          class="font-heading font-semibold text-xs text-white/70 tracking-wider mb-4"
        >
          Productos
        </h4>
        <ul class="space-y-2.5">
          {
            siteConfig.footer.products.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="font-body text-sm text-white/50 hover:text-white transition-colors"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Institucional -->
      <div>
        <h4
          class="font-heading font-semibold text-xs text-white/70 tracking-wider mb-4"
        >
          Institucional
        </h4>
        <ul class="space-y-2.5">
          {
            siteConfig.footer.institutional.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="font-body text-sm text-white/50 hover:text-white transition-colors"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <h4
          class="font-heading font-semibold text-xs text-white/70 tracking-wider mb-4"
        >
          Contacto
        </h4>
        <ul class="space-y-2.5 font-body text-sm text-white/50">
          <li>{siteConfig.contact.location}</li>
          <li>
            <a
              href={`mailto:${siteConfig.contact.email}`}
              class="hover:text-white transition-colors"
            >
              {siteConfig.contact.email}
            </a>
          </li>
          <li>
            <a
              href={`tel:${siteConfig.contact.phone}`}
              class="hover:text-white transition-colors"
            >
              {siteConfig.contact.phone}
            </a>
          </li>
          <li>{siteConfig.contact.hours}</li>
        </ul>
      </div>
    </div>

    <!-- Bottom -->
    <div
      data-reveal="self"
      class="border-t border-white/10 py-8 flex flex-col sm:flex-row items-center justify-between gap-4"
    >
      <p class="font-body text-sm text-white/40">
        &copy; {currentYear}
        <strong class="text-white/70">{siteConfig.name}</strong>. Todos los
        derechos reservados.
      </p>
      <div class="flex items-center gap-3 font-body text-xs text-white/40">
        <a href="#" class="hover:text-white transition-colors"
          >Política de Privacidad</a
        >
        <span>·</span>
        <a href="#" class="hover:text-white transition-colors"
          >Términos y Condiciones</a
        >
        <span>·</span>
        <a href="#" class="hover:text-white transition-colors"
          >Defensa del Consumidor</a
        >
      </div>
    </div>
  </Container>
</footer>
