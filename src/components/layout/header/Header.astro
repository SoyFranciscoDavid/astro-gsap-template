---
import Container from "@components/ui/Container.astro";
import Button from "@components/ui/Button.astro";
import ThemeToggle from "@components/common/ThemeToggle.astro";
import { siteConfig } from "@data/siteConfig";

const navItems = siteConfig.nav;
---

<header
  data-header
  class="fixed top-0 left-0 right-0 z-[var(--z-header)] bg-white backdrop-blur-lg"
>
  <Container>
    <div class="flex items-center justify-between py-[var(--spacing-3)]">
      <!-- Logo -->
      <a
        href="/"
        class="font-heading font-bold text-xl text-[var(--color-primary)] tracking-tight"
      >
        {siteConfig.name}
      </a>

      <!-- Nav Desktop -->
      <nav class="hidden md:flex items-center gap-8">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="font-body text-sm font-medium text-[var(--text-secondary)] hover:text-[var(--color-primary)] transition-colors uppercase tracking-wide"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <!-- CTA + Theme Toggle Desktop -->
      <div class="hidden md:flex items-center gap-4">
        <ThemeToggle />
        <Button
          variant="primary"
          size="sm"
          href={siteConfig.contact ? "mailto:" + siteConfig.contact.email : "#"}
        >
          Contacto
        </Button>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex md:hidden items-center gap-3">
        <ThemeToggle />
        <button
          type="button"
          data-menu-toggle
          aria-label="Abrir menú"
          class="w-10 h-10 border-brutal border-[var(--color-foreground)] flex items-center justify-center text-lg hover:bg-[var(--color-muted)] transition-colors"
        >
          ☰
        </button>
      </div>
    </div>
  </Container>

  <!-- Mobile Drawer -->
  <div
    data-mobile-menu
    class="hidden bg-white border-b-brutal border-[var(--color-foreground)]"
  >
    <Container>
      <nav class="flex flex-col gap-4 py-6">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="font-body text-base font-medium text-[var(--text-secondary)] hover:text-[var(--color-primary)] transition-colors uppercase tracking-wide"
            >
              {item.label}
            </a>
          ))
        }
        <Button
          variant="primary"
          size="md"
          href={siteConfig.contact ? "mailto:" + siteConfig.contact.email : "#"}
          class="mt-2"
        >
          Contacto
        </Button>
      </nav>
    </Container>
  </div>
</header>

<script>
  const toggleBtn = document.querySelector("[data-menu-toggle]");
  const mobileMenu = document.querySelector("[data-mobile-menu]");

  toggleBtn?.addEventListener("click", () => {
    mobileMenu?.classList.toggle("hidden");
  });
</script>
