---
import Container from "@components/ui/Container.astro";
import Button from "@components/ui/Button.astro";
import ThemeToggle from "@components/common/ThemeToggle.astro";
import { siteConfig } from "@data/siteConfig";

const navItems = siteConfig.nav;
---

<header
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 border-b border-transparent bg-[var(--bg-primary)]/50 backdrop-blur-md"
  data-header
>
  <Container class="flex items-center justify-between h-20">
    <!-- Logo -->
    <a
      href="/"
      class="text-xl font-bold tracking-tighter text-[var(--text-primary)]"
    >
      {siteConfig.name}<span class="text-[var(--text-muted)]">.</span>
    </a>

    <!-- Nav Desktop -->
    <nav class="hidden md:flex items-center gap-8">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-[var(--text-secondary)] transition-colors hover:text-[var(--text-primary)]"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- CTA + Theme Toggle Desktop -->
    <div class="hidden md:flex items-center gap-3">
      <ThemeToggle />
      <Button
        variant="primary"
        size="sm"
        href={siteConfig.contact ? "mailto:" + siteConfig.contact.email : "#"}
      >
        Contacto
      </Button>
    </div>

    <!-- Mobile Menu Button -->
    <div class="flex md:hidden items-center gap-2">
      <ThemeToggle />
      <button
        type="button"
        class="p-2 text-[var(--text-secondary)] hover:text-[var(--text-primary)] focus:outline-none"
        data-menu-toggle
        aria-label="Abrir menú"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
      </button>
    </div>
  </Container>

  <!-- Mobile Drawer -->
  <div
    class="hidden md:hidden border-b border-[var(--border-color)] bg-[var(--bg-primary)]/95 px-4 pt-2 pb-6"
    data-mobile-menu
  >
    <nav class="flex flex-col gap-4">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-base font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
          >
            {item.label}
          </a>
        ))
      }
      <Button
        variant="primary"
        size="md"
        href={siteConfig.contact ? "mailto:" + siteConfig.contact.email : "#"}
        class="w-full mt-2"
      >
        Contacto
      </Button>
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.querySelector("[data-menu-toggle]");
  const mobileMenu = document.querySelector("[data-mobile-menu]");

  toggleBtn?.addEventListener("click", () => {
    mobileMenu?.classList.toggle("hidden");
  });
</script>

<script>
  // Toggle menú mobile
  const toggleBtn = document.querySelector("[data-menu-toggle]");
  const mobileMenu = document.querySelector("[data-mobile-menu]");

  toggleBtn?.addEventListener("click", () => {
    mobileMenu?.classList.toggle("hidden");
  });
</script>
