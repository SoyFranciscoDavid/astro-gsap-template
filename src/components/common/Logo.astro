---
import Logo from "@assets/images/logo.svg";
import LogoW from "@assets/images/logo-w.svg";
import { Image } from "astro:assets";
interface Props {
  class?: string;
  size?: "sm" | "md" | "lg";
  variant?: "light" | "dark";
}

const { class: className, size = "md", variant = "light" } = Astro.props;

const textColor =
  variant === "dark" ? "text-white" : "text-[var(--text-primary)]";
const hoverColor =
  variant === "dark"
    ? "group-hover:text-white/80"
    : "group-hover:text-[var(--color-primary)]";

const sizes = {
  sm: { viewBox: "0 0 140 40", iconScale: 1 },
  md: { viewBox: "0 0 160 44", iconScale: 1 },
  lg: { viewBox: "0 0 200 56", iconScale: 1.3 },
};
---

<a
  href="/"
  class={`flex items-center  gap-2  no-underline  group ${className || ""}`}
  aria-label="Matero - Inicio"
>
  <!-- Mate Icon -->
  <!-- {
    variant === "light" ? (
      <Image src={Logo} alt="Logo empresa" class="w-5 " />
    ) : (
      <Image src={LogoW} alt="Logo empresa" class="w-5 pb-2" />
    )
  } -->
  {
    (
      <Image
        src={variant === "light" ? Logo : LogoW}
        alt="Logo empresa"
        class="w-5 pb-1"
      />
    )
  }

  <!-- Text -->
  <span
    class={`block font-heading font-black tracking-tight leading-none mx-0 px-0 ${textColor} ${hoverColor} transition-colors`}
    style="font-size: clamp(1.25rem, 3vw, 1.75rem)"
  >
    MATEROS
  </span>
</a>
