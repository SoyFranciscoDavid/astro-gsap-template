---
import Icon from "@components/ui/Icon.astro";
import { siteConfig } from "@data/siteConfig";

interface Props {
  class?: string;
  variant?: "default" | "outline" | "ghost";
  size?: "sm" | "md" | "lg";
}

const { class: className, variant = "default", size = "md" } = Astro.props;

// Mapeo de redes sociales a íconos de Remix Icon
const socialItems = [
  {
    name: "Instagram",
    url: siteConfig.links.instagram,
    icon: "ri:instagram-fill",
  },
  {
    name: "LinkedIn",
    url: siteConfig.links.linkedin,
    icon: "ri:linkedin-fill",
  },
  {
    name: "WhatsApp",
    url: siteConfig.links.whatsapp,
    icon: "ri:whatsapp-fill",
  },
  {
    name: "Facebook",
    url: siteConfig.links.facebook,
    icon: "ri:facebook-fill",
  },
].filter((item) => item.url);

const sizes = {
  sm: "h-8 w-8 text-xs",
  md: "h-10 w-10 text-sm",
  lg: "h-12 w-12 text-base",
};

const iconSizes = {
  sm: "w-4 h-4",
  md: "w-5 h-5",
  lg: "w-6 h-6",
};

const baseStyles =
  "inline-flex items-center justify-center transition-all duration-200 rounded-[var(--radius-sm)]";

const variants = {
  default:
    "bg-[var(--surface)] border border-[var(--border)] text-[var(--text-secondary)] hover:text-[var(--color-primary)] hover:border-[var(--color-primary)] hover:bg-[var(--bg-tertiary)]",
  outline:
    "border border-[var(--border)] text-[var(--text-secondary)] hover:text-[var(--color-primary)] hover:bg-[var(--bg-tertiary)]",
  ghost:
    "text-[var(--text-secondary)] hover:text-[var(--color-primary)] hover:bg-[var(--bg-tertiary)]",
};
---

<div class=`${className} `>
  {
    socialItems.map((item) => (
      <a
        href={item.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Perfil de ${item.name}`}
        class={`${baseStyles} ${variants[variant]} ${sizes[size]}`}
      >
        <Icon name={item.icon} class={iconSizes[size]} />
      </a>
    ))
  }
</div>
