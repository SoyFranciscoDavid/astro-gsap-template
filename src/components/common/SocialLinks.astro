---
import Icon from "@components/ui/Icon.astro";
import { siteConfig } from "@data/siteConfig";
import { cn } from "@utils/cn";

interface Props {
  class?: string;
  variant?: "default" | "outline" | "ghost";
  size?: "sm" | "md" | "lg";
}

const { class: className, variant = "default", size = "md" } = Astro.props;

// Mapeo de redes sociales a íconos de Remix Icon / FontAwesome
const socialItems = [
  {
    name: "GitHub",
    url: siteConfig.links.github,
    icon: "ri:github-fill",
  },
  {
    name: "LinkedIn",
    url: siteConfig.links.linkedin,
    icon: "ri:linkedin-fill",
  },
  {
    name: "X (Twitter)",
    url: siteConfig.links.twitter
      ? `https://x.com/${siteConfig.twitterHandle}`
      : undefined,
    icon: "ri:twitter-x-fill",
  },
].filter((item) => item.url); // Filtrar solo las redes que estén definidas en siteConfig

const sizes = {
  sm: "h-8 w-8 text-xs",
  md: "h-10 w-10 text-sm",
  lg: "h-12 w-12 text-base",
};

const iconSizes = {
  sm: "w-4 h-4",
  md: "w-5 h-5",
  lg: "w-6 h-6",
};

const baseStyles =
  "inline-flex items-center justify-center rounded-xl transition-all duration-200";

const variants = {
  default:
    "bg-[var(--bg-secondary)] border border-[var(--border-color)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--border-focus)] hover:bg-[var(--bg-tertiary)]",
  outline:
    "border border-[var(--border-color)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-secondary)]",
  ghost:
    "text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-secondary)]",
};
---

<div class={cn("flex items-center gap-2", className)}>
  {
    socialItems.map((item) => (
      <a
        href={item.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Perfil de ${item.name}`}
        class={cn(baseStyles, variants[variant], sizes[size])}
      >
        <Icon name={item.icon} class={iconSizes[size]} />
      </a>
    ))
  }
</div>
