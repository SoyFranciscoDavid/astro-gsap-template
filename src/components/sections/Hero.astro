---
import Container from "@components/ui/Container.astro";
import Button from "@components/ui/Button.astro";
import { siteConfig } from "@data/siteConfig";

const { hero } = siteConfig;
---

<section
  id="home"
  class="relative bg-[var(--color-primary)] text-white min-h-[90vh] flex items-center overflow-hidden"
>
  <!-- Decorative brutal elements -->
  <div
    class="absolute top-8 right-8 w-24 h-24 bg-[var(--color-accent)] border-brutal border-white hidden lg:block"
    style="transform: rotate(6deg);"
  >
  </div>
  <div
    class="absolute bottom-12 left-12 w-16 h-16 bg-white border-brutal border-[var(--color-foreground)] hidden lg:block"
    style="transform: rotate(-3deg);"
  >
  </div>

  <Container>
    <div class="max-w-3xl">
      <!-- Badge -->
      <span
        class="inline-block bg-[var(--color-accent)] text-white border-brutal border-white px-5 py-2 text-sm font-body font-semibold uppercase tracking-widest mb-8"
        style="box-shadow: 4px 4px 0 rgba(255,255,255,0.3);"
      >
        {hero.badge}
      </span>

      <!-- Title -->
      <h1
        class="font-heading text-5xl sm:text-7xl lg:text-8xl font-bold leading-[0.95] tracking-tight mb-6"
      >
        {hero.title}
      </h1>

      <!-- Description -->
      <p
        class="font-body text-lg sm:text-xl text-white/80 max-w-xl mb-10 leading-relaxed"
      >
        {hero.description}
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap gap-4">
        <Button variant="secondary" size="lg" href={hero.primaryCta.href}>
          {hero.primaryCta.label}
        </Button>
        <Button variant="outline" size="lg" href={hero.secondaryCta.href}>
          {hero.secondaryCta.label}
        </Button>
      </div>
    </div>
  </Container>
</section>
