---
import Container from "@components/ui/Container.astro";
import Button from "@components/ui/Button.astro";
import Image from "@components/ui/Image.astro";
import { siteConfig } from "@data/siteConfig";
import { heroImage } from "@data/images";

const { hero } = siteConfig;
---

<section
  id="home"
  class="relative bg-[var(--bg-primary)] text-[var(--text-primary)] min-h-[90vh] flex items-center overflow-hidden border-b border-[var(--border-light)] pt-10 md:pt-0"
>
  <!-- Subtle gradient overlay -->
  <div
    class="absolute inset-0 bg-gradient-to-br from-[var(--color-primary)]/5 to-transparent pointer-events-none"
  >
  </div>

  <Container>
    <div class="grid lg:grid-cols-2 gap-12 items-center relative z-10">
      <!-- Left: Content -->
      <div class="max-w-xl">
        <!-- Badge -->

        <div class="overflow-hidden py-1.5 mb-4 md:mb-6">
          <span
            data-hero="text"
            class="inline-block text-[var(--color-primary)] text-xs font-semibold uppercase tracking-[0.15em]"
          >
            {hero.badge}
          </span>
        </div>

        <!-- Title -->
        <h1
          class="font-heading font-black leading-[0.95] tracking-[-0.02em] mb-6"
          data-title
        >
          {hero.title}
        </h1>

        <!-- Description -->
        <div class="overflow-hidden mb-10">
          <p
            data-hero="text"
            class="font-body text-lg text-[var(--text-secondary)] max-w-xl leading-relaxed"
          >
            {hero.description}
          </p>
        </div>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-4">
          <div class="overflow-hidden">
            <div data-hero="text">
              <Button variant="primary" size="lg" href={hero.primaryCta.href}>
                {hero.primaryCta.label}
              </Button>
            </div>
          </div>
          <div class="overflow-hidden">
            <div data-hero="text">
              <Button variant="outline" size="lg" href={hero.secondaryCta.href}>
                {hero.secondaryCta.label}
              </Button>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Hero Image -->
      <div class="justify-center items-center">
        <div class="relative">
          <div
            class="absolute -inset-4 bg-[var(--color-primary)]/10 rounded-[var(--radius-xl)] -rotate-3"
          >
          </div>
          <div
            data-mate
            class="relative rounded-[var(--radius-lg)] overflow-hidden shadow-[var(--shadow-lg)] lg:invisible"
          >
            <Image
              src={heroImage}
              alt="Mate argentino"
              class="w-70 mx-auto h-auto max-w-md object-cover md:w-full"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
