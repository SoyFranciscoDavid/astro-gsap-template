---
import Container from "@components/ui/Container.astro";
import Heading from "@components/ui/Heading.astro";
import { siteConfig } from "@data/siteConfig";

const { identity } = siteConfig;
---

<section
  id="identity"
  class="py-24 sm:py-32 bg-[var(--color-primary)] text-[var(--color-on-primary)] relative overflow-hidden"
>
  <!-- Subtle pattern overlay (parallax sutil de fondo) -->
  <div
    data-parallax="18"
    class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent pointer-events-none"
  >
  </div>

  <Container>
    <header class="mb-12 text-center" data-reveal>
      <Heading
        as="span"
        size="h4"
        class="text-[var(--color-on-primary)]/70 font-semibold uppercase text-xs tracking-wider"
      >
        {identity.subtitle}
      </Heading>
      <Heading as="h2" size="h2" class="mt-3 text-[var(--color-on-primary)]">
        {identity.title}
      </Heading>
    </header>

    <p
      data-reveal="self"
      class="font-body text-lg text-black/60 max-w-2xl mx-auto mb-16 leading-relaxed text-center"
    >
      {identity.description}
    </p>

    <!-- Explosión revertida: los items parten desordenados y se acomodan -->
    <div
      data-burst
      class="grid grid-cols-2 sm:grid-cols-3 gap-6 max-w-4xl mx-auto"
    >
      {
        identity.metrics.map((metric) => (
          <div
            class:list={[
              "rounded-[var(--radius-lg)] border border-white/20 p-6 text-center backdrop-blur-sm transition-colors duration-300 hover:bg-white/10",
              metric.large && "col-span-1 sm:col-span-1",
            ]}
          >
            {metric.icon && (
              <span class="block text-2xl mb-2">{metric.icon}</span>
            )}
            <strong class="block font-heading text-3xl sm:text-4xl font-black text-[var(--color-on-primary)] mb-1">
              {metric.value.toLocaleString()}
            </strong>
            <span class="block font-body text-xs text-[var(--color-on-primary)]/70 font-medium tracking-wider">
              {metric.label}
            </span>
            {metric.detail && (
              <p class="font-body text-xs text-black/60 mt-2">
                {metric.detail}
              </p>
            )}
          </div>
        ))
      }
    </div>
  </Container>
</section>
