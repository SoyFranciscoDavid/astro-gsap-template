---
import Container from "@components/ui/Container.astro";
import Heading from "@components/ui/Heading.astro";
import { siteConfig } from "@data/siteConfig";

const { identity } = siteConfig;
---

<section
  id="identity"
  class="py-24 sm:py-32 bg-[var(--color-primary)] text-white relative overflow-hidden"
>
  <!-- Decorative -->
  <div
    class="absolute -top-6 -right-6 w-32 h-32 bg-[var(--color-accent)] border-brutal border-white hidden lg:block"
    style="transform: rotate(12deg);"
  >
  </div>

  <Container>
    <header class="mb-12">
      <Heading
        as="span"
        size="h4"
        class="text-[var(--color-accent)] uppercase tracking-widest text-sm font-body"
      >
        {identity.subtitle}
      </Heading>
      <Heading as="h2" size="h2" class="mt-2 text-white">
        {identity.title}
      </Heading>
    </header>

    <p class="font-body text-lg text-white/80 max-w-2xl mb-16 leading-relaxed">
      {identity.description}
    </p>

    <div class="grid grid-cols-2 sm:grid-cols-3 gap-6">
      {
        identity.metrics.map((metric) => (
          <div
            class:list={[
              "bg-white/10 border-brutal border-white/30 p-6 text-center transition-all duration-200 hover:bg-white/20",
              metric.large && "col-span-1 sm:col-span-1",
            ]}
          >
            {metric.icon && (
              <span class="block text-3xl mb-2">{metric.icon}</span>
            )}
            <strong class="block font-heading text-3xl sm:text-4xl font-bold text-white mb-1">
              {metric.value.toLocaleString()}
              {metric.label.includes("%")
                ? ""
                : metric.label.includes("Años")
                  ? ""
                  : ""}
            </strong>
            <span class="block font-body text-sm text-white/70 uppercase tracking-wide">
              {metric.label}
            </span>
            {metric.detail && (
              <p class="font-body text-xs text-white/50 mt-2">
                {metric.detail}
              </p>
            )}
          </div>
        ))
      }
    </div>
  </Container>
</section>
