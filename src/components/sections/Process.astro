---
import Container from "@components/ui/Container.astro";
import Heading from "@components/ui/Heading.astro";
import { siteConfig } from "@data/siteConfig";

const { process } = siteConfig;
---

<section
  id="craft"
  data-process-section
  class="py-24 sm:py-32 bg-[var(--bg-secondary)]"
>
  <Container>
    <header class="mb-16 text-center" data-reveal>
      <Heading as="span" size="h4" class="label">
        {process.subtitle}
      </Heading>
      <Heading as="h2" size="h2" class="mt-3">
        {process.title}
      </Heading>
    </header>

    <div data-process-grid data-reveal class="grid gap-6 sm:grid-cols-2">
      {
        process.steps.map((step) => (
          <article class="border border-[var(--border)] bg-[var(--surface)] rounded-[var(--radius-lg)] p-8 transition-all duration-300 hover:shadow-[var(--shadow-hover)] hover:-translate-y-1">
            <span
              data-parallax="8"
              class="block font-heading text-6xl font-black text-[var(--color-primary)]/15 mb-3 leading-none"
            >
              {step.number}
            </span>
            <h3 class="font-heading text-xl font-bold mb-3 text-[var(--text-primary)]">
              {step.title}
            </h3>
            <p class="font-body text-sm text-[var(--text-secondary)] leading-relaxed">
              {step.description}
            </p>
          </article>
        ))
      }
    </div>
  </Container>
</section>
