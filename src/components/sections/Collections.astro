---
import Container from "@components/ui/Container.astro";
import Heading from "@components/ui/Heading.astro";
import { siteConfig } from "@data/siteConfig";

const { collections } = siteConfig;
---

<section id="collections" class="py-24 sm:py-32 bg-[var(--color-muted)]">
  <Container>
    <header class="mb-16">
      <Heading
        as="span"
        size="h4"
        class="text-[var(--color-accent)] uppercase tracking-widest text-sm font-body"
      >
        {collections.subtitle}
      </Heading>
      <Heading as="h2" size="h2" class="mt-2">
        {collections.title}
      </Heading>
    </header>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        collections.items.map((item) => (
          <article
            class="bg-white border-brutal overflow-hidden transition-all duration-200 hover:shadow-brutal hover:-translate-x-[3px] hover:-translate-y-[3px] cursor-pointer group"
            style="box-shadow: var(--brutal-shadow-sm);"
          >
            <div class="overflow-hidden border-b-brutal border-[var(--color-foreground)]">
              <img
                src={item.image}
                alt={item.name}
                class="w-full h-56 object-cover transition-transform duration-300 group-hover:scale-105"
              />
            </div>
            <div class="p-6">
              <h3 class="font-heading text-xl font-bold mb-2 text-[var(--color-foreground)]">
                {item.name}
              </h3>
              <p class="font-body text-sm text-[var(--text-secondary)] leading-relaxed">
                {item.description}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </Container>
</section>
