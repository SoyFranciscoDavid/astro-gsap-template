---
import Container from "@components/ui/Container.astro";
import Heading from "@components/ui/Heading.astro";
import Image from "@components/ui/Image.astro";
import { siteConfig } from "@data/siteConfig";
import { testimonialImages } from "@data/images";

const { testimonials } = siteConfig;
---

<section id="testimonials" class="py-24 sm:py-32 bg-[var(--bg-tertiary)]">
  <Container>
    <header class="mb-16 text-center" data-reveal>
      <Heading as="span" size="h4" class="label">
        {testimonials.subtitle}
      </Heading>
      <Heading as="h2" size="h2" class="mt-3">
        {testimonials.title}
      </Heading>
    </header>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
      {
        testimonials.items.map((item, idx) => (
          <article class="bg-[var(--surface)] border border-[var(--border)] rounded-[var(--radius-lg)] p-8 flex flex-col justify-between transition-all duration-300 hover:shadow-[var(--shadow-hover)] hover:-translate-y-1">
            <div>
              <span class="block text-4xl text-[var(--color-primary)]/30 mb-3 font-heading leading-none">
                &ldquo;
              </span>
              <p class="font-body text-[var(--text-secondary)] leading-relaxed mb-8 text-sm">
                {item.quote}
              </p>
            </div>
            <div class="flex items-center gap-4 pt-6 border-t border-[var(--border-light)]">
              <div class="flex-shrink-0 w-11 h-11 rounded-full overflow-hidden bg-[var(--bg-tertiary)] border border-[var(--border-light)]">
                <Image
                  src={testimonialImages[idx]}
                  alt={item.author.name}
                  class="w-full h-full object-cover"
                />
              </div>
              <div>
                <strong class="block font-heading font-semibold text-sm text-[var(--text-primary)]">
                  {item.author.name}
                </strong>
                <span class="block font-body text-xs text-[var(--text-muted)]">
                  {item.author.role}
                </span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </Container>
</section>
