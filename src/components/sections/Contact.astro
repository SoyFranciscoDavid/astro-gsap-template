---
import Container from "@components/ui/Container.astro";
import Heading from "@components/ui/Heading.astro";
import Button from "@components/ui/Button.astro";
import { siteConfig } from "@data/siteConfig";

const { contact } = siteConfig;
---

<section id="contact" class="py-24 sm:py-32 bg-[var(--color-muted)]">
  <Container>
    <div class="grid gap-12 lg:grid-cols-2">
      <!-- Left: Info -->
      <div>
        <Heading as="h2" size="h2" class="mb-4">
          {contact.title}
        </Heading>
        <Heading
          as="p"
          size="h4"
          class="text-[var(--text-secondary)] font-body mb-10"
        >
          {contact.subtitle}
        </Heading>

        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <span
              class="flex-shrink-0 w-10 h-10 bg-[var(--color-primary)] text-white border-brutal border-[var(--color-foreground)] flex items-center justify-center text-sm"
              >📍</span
            >
            <div>
              <span
                class="block font-heading font-bold text-[var(--color-foreground)]"
                >Ubicación</span
              >
              <span class="block font-body text-[var(--text-secondary)]"
                >{contact.location}</span
              >
            </div>
          </div>

          <div class="flex items-start gap-4">
            <span
              class="flex-shrink-0 w-10 h-10 bg-[var(--color-primary)] text-white border-brutal border-[var(--color-foreground)] flex items-center justify-center text-sm"
              >✉</span
            >
            <div>
              <span
                class="block font-heading font-bold text-[var(--color-foreground)]"
                >Email</span
              >
              <a
                href={`mailto:${contact.email}`}
                class="block font-body text-[var(--color-secondary)] hover:underline"
                >{contact.email}</a
              >
            </div>
          </div>

          <div class="flex items-start gap-4">
            <span
              class="flex-shrink-0 w-10 h-10 bg-[var(--color-primary)] text-white border-brutal border-[var(--color-foreground)] flex items-center justify-center text-sm"
              >☎</span
            >
            <div>
              <span
                class="block font-heading font-bold text-[var(--color-foreground)]"
                >Teléfono</span
              >
              <a
                href={`tel:${contact.phone}`}
                class="block font-body text-[var(--color-secondary)] hover:underline"
                >{contact.phone}</a
              >
            </div>
          </div>

          <div class="flex items-start gap-4">
            <span
              class="flex-shrink-0 w-10 h-10 bg-[var(--color-primary)] text-white border-brutal border-[var(--color-foreground)] flex items-center justify-center text-sm"
              >🕐</span
            >
            <div>
              <span
                class="block font-heading font-bold text-[var(--color-foreground)]"
                >Horarios</span
              >
              <span class="block font-body text-[var(--text-secondary)]"
                >{contact.hours}</span
              >
            </div>
          </div>
        </div>
      </div>

      <!-- Right: CTA Card -->
      <div
        class="bg-white border-brutal p-10 flex flex-col justify-center items-center text-center"
        style="box-shadow: var(--brutal-shadow);"
      >
        <span class="block font-heading text-5xl mb-4">🤝</span>
        <h3
          class="font-heading text-2xl font-bold mb-4 text-[var(--color-foreground)]"
        >
          ¿Listo para trabajar juntos?
        </h3>
        <p class="font-body text-[var(--text-secondary)] mb-8 max-w-sm">
          Contactanos para conocer nuestro catálogo completo y condiciones de
          distribución mayorista.
        </p>
        <Button variant="primary" size="lg" href={`mailto:${contact.email}`}>
          Escribinos
        </Button>
      </div>
    </div>
  </Container>
</section>
