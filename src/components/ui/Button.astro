---
interface Props extends astroHTML.JSX.ButtonHTMLAttributes {
  variant?: "primary" | "secondary" | "outline" | "ghost";
  size?: "sm" | "md" | "lg";
  class?: string;
  href?: string; // Permite que funcione como link estilizado como botón
}

const {
  variant = "primary",
  size = "md",
  class: className,
  href,
  ...rest
} = Astro.props;

const baseStyles =
  "inline-flex items-center justify-center font-body font-semibold transition-all duration-200 border cursor-pointer rounded-[var(--radius-md)] tracking-wide";

const variants = {
  primary:
    "bg-[var(--color-primary)] text-[var(--color-on-primary)] border-[var(--color-primary)] hover:opacity-90 hover:shadow-[var(--shadow-md)] active:scale-[0.98]",
  secondary:
    "bg-[var(--color-secondary)] text-[var(--color-on-secondary)] border-[var(--color-secondary)] hover:opacity-90 hover:shadow-[var(--shadow-md)] active:scale-[0.98]",
  outline:
    "bg-transparent text-[var(--text-primary)] border-[var(--border)] hover:bg-[var(--bg-tertiary)] hover:border-[var(--text-primary)] active:scale-[0.98]",
  ghost:
    "bg-transparent text-[var(--text-muted)] border-transparent hover:text-[var(--text-primary)] hover:bg-[var(--bg-tertiary)] active:scale-[0.98]",
};

const sizes = {
  sm: "h-9 px-4 text-xs",
  md: "h-11 px-6 text-sm",
  lg: "h-14 px-8 text-base",
};

const classes = [
  baseStyles,
  variants[variant] || variants.primary,
  sizes[size] || sizes.md,
  className
]
  .filter(Boolean)
  .join(" ");
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button class={classes} {...rest}>
      <slot />
    </button>
  )
}
