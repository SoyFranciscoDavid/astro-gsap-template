---
interface Props extends astroHTML.JSX.ButtonHTMLAttributes {
  variant?: "primary" | "secondary" | "outline" | "ghost";
  size?: "sm" | "md" | "lg";
  class?: string;
  href?: string; // Permite que funcione como link estilizado como botón
}

const {
  variant = "primary",
  size = "md",
  class: className,
  href,
  ...rest
} = Astro.props;

const baseStyles =
  "inline-flex items-center justify-center font-body font-semibold tracking-wide transition-all duration-200 border-brutal cursor-pointer uppercase";

const variants = {
  primary:
    "bg-[var(--color-primary)] text-white border-[var(--color-foreground)] hover:shadow-brutal hover:-translate-x-[3px] hover:-translate-y-[3px] active:translate-x-[3px] active:translate-y-[3px] active:shadow-none",
  secondary:
    "bg-[var(--color-accent)] text-white border-[var(--color-foreground)] hover:shadow-brutal hover:-translate-x-[3px] hover:-translate-y-[3px] active:translate-x-[3px] active:translate-y-[3px] active:shadow-none",
  outline:
    "bg-transparent text-[var(--color-foreground)] border-[var(--color-foreground)] hover:bg-[var(--color-foreground)] hover:text-white",
  ghost:
    "bg-transparent text-[var(--color-foreground)] border-transparent hover:border-[var(--color-foreground)] hover:bg-[var(--color-muted)]",
};

const sizes = {
  sm: "h-10 px-4 text-xs",
  md: "h-12 px-6 text-sm",
  lg: "h-14 px-8 text-base",
};

const classes = className;
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button class={classes} {...rest}>
      <slot />
    </button>
  )
}
