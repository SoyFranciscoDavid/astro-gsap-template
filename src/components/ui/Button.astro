---
import { cn } from "@utils/cn";

interface Props extends astroHTML.JSX.ButtonHTMLAttributes {
  variant?: "primary" | "secondary" | "outline" | "ghost";
  size?: "sm" | "md" | "lg";
  class?: string;
  href?: string; // Permite que funcione como link estilizado como botón
}

const {
  variant = "primary",
  size = "md",
  class: className,
  href,
  ...rest
} = Astro.props;

const baseStyles =
  "inline-flex items-center justify-center font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--border-focus)] disabled:pointer-events-none disabled:opacity-50 cursor-pointer";

const variants = {
  primary: "bg-[var(--text-primary)] text-[var(--bg-primary)] hover:opacity-90",
  secondary:
    "bg-[var(--bg-tertiary)] text-[var(--text-primary)] hover:bg-[var(--border-color)]",
  outline:
    "border border-[var(--border-color)] bg-transparent text-[var(--text-primary)] hover:bg-[var(--bg-secondary)]",
  ghost:
    "bg-transparent text-[var(--text-primary)] hover:bg-[var(--bg-secondary)]",
};

const sizes = {
  sm: "h-9 px-3 text-xs rounded-md",
  md: "h-11 px-5 text-sm rounded-lg",
  lg: "h-14 px-8 text-base rounded-xl",
};

const classes = cn(baseStyles, variants[variant], sizes[size], className);
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button class={classes} {...rest}>
      <slot />
    </button>
  )
}
