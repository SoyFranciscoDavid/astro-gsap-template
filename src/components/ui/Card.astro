---
import { cn } from "@utils/cn";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class={cn(
    "rounded-2xl border border-[var(--border-color)] bg-[var(--bg-secondary)]/50 p-6 backdrop-blur-sm transition-all duration-300 hover:border-[var(--border-focus)]",
    className,
  )}
>
  <slot />
</div>
