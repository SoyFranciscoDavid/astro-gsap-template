---
import { cn } from "@utils/cn";

interface Props {
  class?: string;
  hover?: boolean;
}

const { class: className, hover = true } = Astro.props;
---

<div
  class={cn(
    "border-brutal bg-white p-6 transition-all duration-200",
    hover &&
      "hover:shadow-brutal hover:-translate-x-[3px] hover:-translate-y-[3px] cursor-pointer",
    className,
  )}
  style="box-shadow: var(--brutal-shadow-sm);"
>
  <slot />
</div>
