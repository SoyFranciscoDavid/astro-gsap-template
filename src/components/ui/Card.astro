---
import { cn } from "@utils/cn";

interface Props {
  class?: string;
  hover?: boolean;
}

const { class: className, hover = true } = Astro.props;
---

<div
  class={cn(
    "border border-[var(--border)] bg-[var(--surface)] rounded-[var(--radius-lg)] p-6 transition-all duration-300",
    hover &&
      "hover:shadow-[var(--shadow-hover)] hover:-translate-y-1 cursor-pointer",
    className,
  )}
>
  <slot />
</div>
