---
interface Props {
  src: { src: string; width: number; height: number; format?: string };
  alt: string;
  class?: string;
  loading?: "lazy" | "eager";
  decoding?: "async" | "sync" | "auto";
  widths?: number[];
  sizes?: string;
}

const {
  src,
  alt,
  class: className,
  loading = "lazy",
  decoding = "async",
} = Astro.props;
---

<img
  src={src.src}
  width={src.width}
  height={src.height}
  alt={alt}
  class={className}
  loading={loading}
  decoding={decoding}
  style="object-fit: cover;"
  onerror="this.style.display='none'"
/>
